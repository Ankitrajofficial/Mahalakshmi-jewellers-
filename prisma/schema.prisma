// Mahalaxmi Jewellers Jaipur — data model
// Jewellery is not a t-shirt: price is derived from weight, purity, wastage,
// making charge and stone value, never typed in. See src/lib/pricing.ts.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Metal {
  GOLD
  SILVER
  PLATINUM
}

enum PricingMode {
  DYNAMIC_BY_WEIGHT
  FIXED
}

enum MakingType {
  PER_GRAM
  PERCENT
  FLAT
}

enum ImageKind {
  PRODUCT
  LIFESTYLE
  SCALE
  CERTIFICATE
}

enum Role {
  CUSTOMER
  STAFF
  ADMIN
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  IN_PRODUCTION
  PACKED
  DISPATCHED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
}

enum EnquiryKind {
  CONTACT
  CUSTOM_ORDER
  SHOWROOM_VISIT
  PRODUCT
}

enum CouponType {
  PERCENT
  FLAT
}

model Category {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String    @db.Text
  heroCopy    String    @db.Text
  image       String
  position    Int       @default(0)
  isActive    Boolean   @default(true)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([position])
}

model Product {
  id               String   @id @default(cuid())
  slug             String   @unique
  name             String
  shortDescription String
  description      String   @db.Text
  craftsmanship    String   @db.Text
  careNotes        String   @db.Text
  category         Category @relation(fields: [categoryId], references: [id])
  categoryId       String
  collectionTags   String[] // "Bridal", "Daily Wear", "Temple", "Office", "Festive"

  // Material and purity
  metal           Metal
  purity          String // "22K", "18K", "14K", "925 Sterling"
  metalColour     String? // "Yellow", "Rose", "White"
  grossWeightG    Decimal @db.Decimal(10, 3)
  netMetalWeightG Decimal @db.Decimal(10, 3) // gross minus stones

  // Stones
  stones Stone[]

  // Pricing inputs
  pricingMode       PricingMode
  makingChargeType  MakingType
  makingChargeValue Decimal     @db.Decimal(10, 2)
  wastagePercent    Decimal?    @db.Decimal(5, 2)
  fixedPrice        Decimal?    @db.Decimal(12, 2) // used only when pricingMode = FIXED

  // Compliance
  bisHallmarked Boolean @default(true)
  huid          String? // 6-digit HUID
  certification String? // "IGI", "GIA", "SGL"

  // Commerce
  sku           String   @unique
  stockQty      Int      @default(1)
  isMadeToOrder Boolean  @default(false)
  leadTimeDays  Int?
  sizeOptions   String[]
  dimensions    String?
  images        Image[]
  video         String?
  isActive      Boolean  @default(true)
  isFeatured    Boolean  @default(false)

  // SEO
  metaTitle       String?
  metaDescription String?

  reviews    Review[]
  cartItems  CartItem[]
  orderItems OrderItem[]
  wishlisted WishlistItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([isActive, isFeatured])
  @@index([metal, purity])
}

model Stone {
  id            String  @id @default(cuid())
  product       Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId     String
  type          String // Diamond, Polki, Emerald, Ruby, Pearl, Kundan
  shape         String?
  count         Int     @default(1)
  carat         Decimal @db.Decimal(8, 3)
  clarity       String?
  colour        String?
  certification String?
  ratePerCarat  Decimal @db.Decimal(12, 2)

  @@index([productId])
}

model Image {
  id          String    @id @default(cuid())
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId   String
  url         String
  alt         String
  kind        ImageKind @default(PRODUCT)
  width       Int       @default(1600)
  height      Int       @default(1600)
  blurDataURL String?
  position    Int       @default(0)

  @@index([productId, position])
}

/// One row per metal + purity per day. Changing today's row re-prices every
/// DYNAMIC_BY_WEIGHT product across the entire site.
model MetalRate {
  id          String   @id @default(cuid())
  date        DateTime @db.Date
  metal       Metal
  purity      String
  ratePerGram Decimal  @db.Decimal(12, 2)
  source      String   @default("MANUAL")
  updatedAt   DateTime @updatedAt

  @@unique([date, metal, purity])
  @@index([date])
}

model User {
  id              String         @id @default(cuid())
  phone           String?        @unique
  email           String?        @unique
  name            String?
  role            Role           @default(CUSTOMER)
  phoneVerified   DateTime?
  emailVerified   DateTime?
  savedRingSize   String?
  savedBangleSize String?
  addresses       Address[]
  orders          Order[]
  carts           Cart[]
  reviews         Review[]
  wishlist        WishlistItem[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model OtpToken {
  id        String   @id @default(cuid())
  phone     String
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([phone, expiresAt])
}

model Address {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  fullName  String
  phone     String
  line1     String
  line2     String?
  landmark  String?
  city      String
  state     String
  pincode   String
  country   String   @default("India")
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model Cart {
  id          String     @id @default(cuid())
  user        User?      @relation(fields: [userId], references: [id])
  userId      String?
  /// Anonymous cart key stored in a httpOnly cookie for guest checkout.
  guestKey    String?    @unique
  items       CartItem[]
  couponCode  String?
  /// Server-side price lock. Rates captured here are honoured until lockedUntil.
  lockedRates Json?
  lockedUntil DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([userId])
}

model CartItem {
  id            String   @id @default(cuid())
  cart          Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  cartId        String
  product       Product  @relation(fields: [productId], references: [id])
  productId     String
  quantity      Int      @default(1)
  size          String?
  /// Breakdown snapshot taken when the item entered the cart, used to enforce the lock.
  priceSnapshot Json
  createdAt     DateTime @default(now())

  @@unique([cartId, productId, size])
  @@index([cartId])
}

model Coupon {
  id          String     @id @default(cuid())
  code        String     @unique
  type        CouponType
  value       Decimal    @db.Decimal(10, 2)
  minSubtotal Decimal?   @db.Decimal(12, 2)
  maxDiscount Decimal?   @db.Decimal(12, 2)
  description String
  usageLimit  Int?
  usedCount   Int        @default(0)
  startsAt    DateTime   @default(now())
  expiresAt   DateTime?
  isActive    Boolean    @default(true)
  orders      Order[]
  createdAt   DateTime   @default(now())
}

model Order {
  id            String        @id @default(cuid())
  orderNumber   String        @unique
  user          User?         @relation(fields: [userId], references: [id])
  userId        String?
  email         String
  phone         String
  status        OrderStatus   @default(PENDING_PAYMENT)
  paymentStatus PaymentStatus @default(CREATED)

  items OrderItem[]

  /// Full shipping address snapshot — addresses may be edited or deleted later.
  shippingAddress Json
  billingAddress  Json?

  subtotal Decimal @db.Decimal(12, 2)
  gst      Decimal @db.Decimal(12, 2)
  discount Decimal @default(0) @db.Decimal(12, 2)
  shipping Decimal @default(0) @db.Decimal(12, 2)
  total    Decimal @db.Decimal(12, 2)
  coupon   Coupon? @relation(fields: [couponId], references: [id])
  couponId String?

  razorpayOrderId   String? @unique
  razorpayPaymentId String?
  razorpaySignature String?

  /// Rate board applied at order time, so an invoice can always be reproduced.
  rateSnapshot Json

  /// Abandoned-checkout nudges already sent for this order (0, 1 or 2).
  /// Section 10: WhatsApp reminders at 1 hour and 24 hours.
  nudgeStage Int       @default(0)
  nudgedAt   DateTime?

  trackingCarrier String?
  trackingNumber  String?
  dispatchedAt    DateTime?
  deliveredAt     DateTime?
  invoiceNumber   String?
  notes           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id        String  @id @default(cuid())
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  product   Product @relation(fields: [productId], references: [id])
  productId String

  // Snapshot — the product may change or be delisted after the sale.
  name     String
  sku      String
  slug     String
  image    String
  size     String?
  quantity Int     @default(1)

  purity          String
  grossWeightG    Decimal @db.Decimal(10, 3)
  netMetalWeightG Decimal @db.Decimal(10, 3)
  huid            String?

  // Full price breakdown at time of order — every component, not just the total.
  ratePerGram  Decimal @db.Decimal(12, 2)
  metalValue   Decimal @db.Decimal(12, 2)
  wastageValue Decimal @db.Decimal(12, 2)
  makingCharge Decimal @db.Decimal(12, 2)
  stoneValue   Decimal @db.Decimal(12, 2)
  subtotal     Decimal @db.Decimal(12, 2)
  gst          Decimal @db.Decimal(12, 2)
  lineTotal    Decimal @db.Decimal(12, 2)

  @@index([orderId])
}

model Review {
  id          String   @id @default(cuid())
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId   String
  user        User?    @relation(fields: [userId], references: [id])
  userId      String?
  author      String
  city        String
  rating      Int
  title       String
  body        String   @db.Text
  photos      String[]
  verified    Boolean  @default(false)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([productId])
}

model Enquiry {
  id              String      @id @default(cuid())
  kind            EnquiryKind @default(CONTACT)
  name            String
  phone           String
  email           String?
  message         String      @db.Text
  /// Uploaded reference images for bespoke / made-to-order enquiries.
  referenceImages String[]
  budget          String?
  occasion        String?
  productSlug     String?
  handled         Boolean     @default(false)
  createdAt       DateTime    @default(now())

  @@index([kind, handled])
}

model Post {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  excerpt         String
  category        String
  readingMinutes  Int      @default(6)
  author          String   @default("Mahalaxmi Jewellers")
  heroImage       String
  body            String   @db.Text
  metaTitle       String?
  metaDescription String?
  isPublished     Boolean  @default(true)
  publishedAt     DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/// Editable home-page and site content blocks managed from /admin.
model CmsBlock {
  id        String   @id @default(cuid())
  key       String   @unique
  title     String
  content   Json
  updatedAt DateTime @updatedAt
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String   @default("footer")
  createdAt DateTime @default(now())
}
