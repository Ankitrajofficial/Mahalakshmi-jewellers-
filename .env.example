# ─────────────────────────────────────────────────────────────────────────────
# Mahalaxmi Jewellers Jaipur — environment
# Copy to .env and fill in. Everything marked OPTIONAL has a working fallback,
# so `npm run dev` succeeds with this file entirely unedited.
# ─────────────────────────────────────────────────────────────────────────────

# ── Site ─────────────────────────────────────────────────────────────────────
# Canonical origin, no trailing slash. Used for metadata, JSON-LD, sitemap and
# every absolute URL in emails and WhatsApp messages.
NEXT_PUBLIC_SITE_URL=https://mahalaxmijewellersjaipur.com

# ── Database (OPTIONAL for local development) ────────────────────────────────
# PostgreSQL. Without it the site reads the seeded catalogue in src/data and
# stores orders, enquiries and OTPs in ./.data — full storefront, read-only
# catalogue. With it, everything is editable from /admin.
#   DATABASE_URL="postgresql://user:password@localhost:5432/mahalaxmi?schema=public"
DATABASE_URL=

# ── Auth ─────────────────────────────────────────────────────────────────────
# Signing key for the session cookie. REQUIRED in production, minimum 32 chars.
#   openssl rand -base64 48
AUTH_SECRET=

# Comma-separated 10-digit mobile numbers that get staff access to /admin.
ADMIN_PHONES=9521061429,9216861429

# ── Payments — Razorpay ──────────────────────────────────────────────────────
# REQUIRED in production. Without these, checkout runs in a development-only
# simulated mode that marks orders paid without charging anything, and refuses
# to run at all when NODE_ENV=production.
# Test keys start rzp_test_, live keys rzp_live_.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Set this to the secret you enter when creating the webhook in the Razorpay
# dashboard, pointed at https://your-domain/api/razorpay/webhook
# Subscribe to: payment.captured, payment.failed, order.paid
RAZORPAY_WEBHOOK_SECRET=

# ── Transactional email — Resend (OPTIONAL) ──────────────────────────────────
# Without a key, emails are logged to the server console instead of sent.
RESEND_API_KEY=
EMAIL_FROM="Mahalaxmi Jewellers <orders@mahalaxmijewellersjaipur.com>"
# Where customer enquiries are forwarded.
ENQUIRY_EMAIL=orders@mahalaxmijewellersjaipur.com

# ── WhatsApp Business API (OPTIONAL) ─────────────────────────────────────────
# Without these, order updates fall back to the click-to-chat links that are on
# every page, and outbound messages are logged rather than sent.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ── SMS for login OTP (OPTIONAL) ─────────────────────────────────────────────
# Any provider that accepts { to, message } as JSON with a bearer token.
# Without it, the OTP is printed to the server console and shown in the UI
# outside production so the flow can be completed locally.
SMS_API_URL=
SMS_API_KEY=

# ── Image CDN — Cloudinary (OPTIONAL) ────────────────────────────────────────
# For customer uploads (review photos, custom-order references). Without it,
# uploads are written to ./.data/uploads and served from /api/media/[id].
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=

# ── Analytics (OPTIONAL) ─────────────────────────────────────────────────────
# Both tags are omitted entirely when unset.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# ── Invoicing ────────────────────────────────────────────────────────────────
# Printed on every GST invoice. Confirm with the owner before launch.
NEXT_PUBLIC_GSTIN=
NEXT_PUBLIC_LEGAL_NAME=Mahalaxmi Jewellers

# ── Scheduled jobs ────────────────────────────────────────────────────────────
# Bearer token for /api/cron/abandoned (the hourly abandoned-checkout nudge).
# Vercel signs its own cron calls, so this is only needed for external schedulers.
CRON_SECRET=
